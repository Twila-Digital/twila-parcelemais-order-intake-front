NEXT_PUBLIC_ENVIRONMENT=development
# Host da API (sem /api/v1). Só o servidor do front chama a API.
API_URL=https://api.staging.credicarro.com.br
# Segredo compartilhado com o backend para a assinatura HMAC. Nunca use NEXT_PUBLIC_.
INTAKE_HMAC_SECRET=
NEXT_PUBLIC_IN_MAINTENANCE=false
# Host do gateway (sem /api) para o WebSocket do intake (SignalR); o browser conecta direto.
NEXT_PUBLIC_WEBSOCKET_URL=https://api.staging.credicarro.com.br
# Site do Parcele Mais (sem barra no fim); a tela final leva para /painel/propostas/{id}.
NEXT_PUBLIC_PARCELEMAIS_URL=https://staging.parcelemais.com.br
# Em segundos
NEXT_REQUEST_TIMEOUT=30

# DATADOG (opcional; só inicializa em production)
NEXT_PUBLIC_DATADOG_CLIENT_SERVICE=
DATADOG_APP_ID=
DATADOG_CLIENT_TOKEN=

# E2E (Playwright)
E2E_BASE_URL=http://localhost:3000
